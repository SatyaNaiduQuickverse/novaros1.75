# Vehicle configuration — companion connector layer.
# Every value here overrides a default in companion/config.py.
#
# Airframe: BOARD CHANGED 2026-08-04 -> STM32F405, Betaflight 4.5.1 (MSP API
# 1.46), MSP Override present. Previously SpeedyBee F7 V3 / BTFL 26.6.1.
# Companion: Raspberry Pi 5, FC on USB-C (VCP). Receiver: ELRS/CRSF on UART2.
#
# Required FC configuration, saved to EEPROM:
#   set msp_override_channels_mask = 15     # binary 1111 = channels 1-4 only
#   aux <slot> 50 3 1700 2100 0 0           # box id 50 = MSP OVERRIDE on ch8

fc:
  # BOARD CHANGED 2026-08-04 — the new FC has not been identified yet, so this
  # is back to "auto": resolve the single Betaflight board under
  # /dev/serial/by-id/. resolve_port() still refuses to guess when more than one
  # is present, which is the protection that mattered; an ESP32 on this Pi can
  # never be picked up because the glob matches *Betaflight* only.
  # Identified 2026-08-04 with tools/find_fc.py: BTFL 4.5.1, MSP API 1.46,
  # STM32F405, MSP OVERRIDE present, 30 boxes.
  # NB this by-id string carries no unique serial (unlike the F7 boards, which
  # had 366D335B3333 / 3678336D3333) — a second F405 would enumerate to the
  # same path, so find_fc.py is the way to confirm which board answered.
  # An ESP32 on this Pi holds ttyACM0, so the FC is on ttyACM1: by-id only.
  port: /dev/serial/by-id/usb-Betaflight_Betaflight_STM32F405_0x8000000-if00
  baud: 115200
  timeout_s: 1.0
  # MEASURED 2026-08-04 on THIS board (F405 / BTFL 4.5.1): every MSP
  # request/response costs ~16.05 ms -> a hard ceiling of ~62 transactions/sec,
  # SHARED by the RC stream, telemetry (2 txn/cycle) and the watchdog (3 txn/
  # check with verify_wire on). The F722 board managed ~99 at 10.1 ms, so this
  # is a per-board property and the rates below do NOT carry across a swap.
  # Over-subscribing never errors, it just silently degrades every rate.
  # 35 + 2*6 + 3*2 = 53 txn/s = 85% of 62, verified holding its rates.
  # Freshness is not the constraint: the override times out around 250 ms, so
  # 35 Hz still carries ~9x margin.
  msp_txn_per_sec: 62.0
  # With the dedicated ESP32 IMU as the attitude source, the FC telemetry
  # leaves the tick entirely and the budget frees up: 45 + 2*2 + 3*2 = 55/62
  # = 89%. Telemetry is kept at 2 Hz only to log the FC's OWN attitude next to
  # the ESP32's — that cross-check is the only way a disagreement between the
  # two would ever be noticed, and it costs 4 txn/s to keep.
  rc_hz: 45.0
  telemetry_hz: 2.0
  watchdog_hz: 2.0
  verify_wire: true

channels:
  # Zero-based indices into MSP_RC. Read-only: the companion transmits ch1-4 only.
  override_index: 7     # ch8  / AUX4 — MSP OVERRIDE switch
  arm_index: 8          # ch9  / AUX5 — ARM. Pilot's alone.
  angle_index: 4        # ch5  — ANGLE mode, active when the switch is LOW
  override_active_us: 1700
  # MUST match msp_override_channels_mask on the FC — change both together.
  #   15 (0b1111) companion owns roll/pitch/yaw/throttle  <- current
  #   11 (0b1011) companion owns roll/pitch/yaw; PILOT keeps throttle
  # Verified against the firmware 2026-08-04 with: bringup authority
  # A mismatch is not cosmetic — the wire-envelope check would police the
  # wrong channels and can abort the stream on the pilot's own throttle.
  override_mask: 15

limits:
  # bench | tethered | flight. Keep "bench" until the whole loop is verified.
  # thr_cap 1100 is ~10% stick: motors respond, thrust is negligible.
  profile: bench

imu:
  # RE-MEASURED on the NEW F405 board 2026-08-04 at rest:
  #   raw acc = [34.2, -240.9, 2027.9]  |acc| = 2042.4  -> acc_per_g 2042
  #   raw gyro = [-0.32, -0.49, -0.14]  -> dps confirmed (sub-degree at rest)
  #   gravity on board axis 2, sign +1 -> board z is UP, FRD negates it (same
  #   as the old board), so the z row below is confirmed.
  # STILL UNVERIFIED on this board: the x/y rows and the attitude signs — they
  # need the nose-up / roll-right tilts. Run:  bringup calib-imu
  #
  # ⚠️ Previous board's numbers, kept for comparison only:
  # (366D335B3333) and does not carry over to a different flight controller.
  # acc_per_g depends on that board's acc_1G and its MSP scaling, and the axis
  # map depends on how the board is mounted in the airframe. Both must be
  # re-measured with `bringup calib-imu` before the new FC is trusted; until
  # then `verified: false` keeps preflight complaining, which is correct.
  # Kept only as a starting guess and for comparison.
  #
  # PREVIOUS BOARD, level and at rest:
  #   raw acc = [-12.5, 2.6, 2062.4], raw gyro = [-0.25, 1.13, -0.15]
  # This build sends accADC UNSCALED (acc_1G 2048), not accADC/4 — the generic
  # 512 default was wrong by 4x and read gravity as 39.5 m/s^2. 2062 is the
  # measured value and absorbs the sensor's ~0.7% scale error.
  acc_per_g: 2042.0
  # Sub-degree noise at rest confirms degrees/second, not raw LSB.
  gyro_units: dps
  # Gravity sits on board axis 2, positive, so board z is UP and FRD z negates
  # it — confirmed by the level reading. The x/y rows are still the ASSUMED
  # map: they need the nose-up and roll-right tilts to confirm, which is why
  # verified stays false. Run:  python3 -m tools.bringup calib-imu
  board_to_frd:         # [source index, sign] per FRD axis: x fwd, y right, z down
    - [0, +1.0]
    - [1, -1.0]
    - [2, -1.0]
  # ✅ pitch_sign MEASURED 2026-08-05, and it is NOT the textbook sign.
  # Front of the aircraft pointed at the ceiling, held to 0.1 deg of spread:
  # this firmware reported pitch = -88.2. So Betaflight is positive NOSE DOWN
  # here, where the standard ZYX euler decode assumes positive nose up.
  # Corroborated at rest: level-ish it read pitch +2.7 (i.e. nose down 2.7 by
  # the real convention) and its own accelerometer put "up" at x = -0.047,
  # exactly where nose-down 2.7 predicts. Both agree, which also clears the
  # board_to_frd decode of suspicion — only the pitch sign was wrong.
  # This single flipped sign accounted for a 45 deg residual in the ESP32 axis
  # map: every pair had its x component inverted, which no rotation can
  # reconcile, so the fit refused. Measure attitude signs, never assume them.
  # roll_sign MEASURED the same way and it IS the textbook sign: right side
  # down, nose level, held to 0.0 deg of spread -> roll +51.0. Do not infer
  # one sign from the other; pitch was non-standard here and roll was not.
  roll_sign: +1.0
  pitch_sign: -1.0
  # yaw_sign is still UNVERIFIED. It cannot be measured from gravity at all, so
  # neither this rig nor the ESP32 (which has no magnetometer) can settle it.
  yaw_sign: +1.0
  verified: false

camera:
  # UNVERIFIED — replace with an OpenCV checkerboard calibration, and set the
  # cam_* basis from the actual mount (boresight). See docs/SETUP_HARDWARE.md.
  width: 1280
  height: 720
  fx: 1650.0
  fy: 1650.0
  cx: 640.0
  cy: 360.0
  dist_coeffs: []       # [k1, k2, p1, p2, k3]
  cam_fwd:   [1.0, 0.0,  0.0]
  cam_right: [0.0, 1.0,  0.0]
  cam_up:    [0.0, 0.0, -1.0]
  object_size_m: 0.4    # widest dimension of the tracked object
  min_box_px: 26
  verified: false

log_dir: ~/logs

# --- dedicated companion IMU: MPU6500 on ESP32-C6 over USB CDC -------------
# The flight-article attitude source. ESP32-C6FH4 (MAC 8c:fd:49:11:35:50)
# running MicroPython 1.28.0 + esp32/main.py; MPU6500 at I2C 0x68 on
# SCL=GPIO19 / SDA=GPIO20, streaming 200 Hz framed binary.
# The board is labelled MPU9250 but WHO_AM_I reads 0x70 and no AK8963 appears
# at 0x0C even with I2C bypass enabled -> it is a 6-axis die. NO MAGNETOMETER,
# so yaw has no absolute reference and will drift; roll/pitch are observable.
imu32:
  enabled: true
  port: ""              # auto-detect the Espressif device
  baud: 921600
  # MEASURED at rest 2026-08-04 over 1216 samples (accel spread 0.14%, still):
  #   gyro bias = [-3.49, 8.76, -1.22] dps — large, and it MUST be applied:
  #   uncorrected it fought the gravity correction and left a 3.4 deg error.
  # Re-measured later the same day: [-67.7, 141.9, -22.3]. y and z held, x
  # walked ~10 counts (0.6 dps) — normal for this part, and the reason the
  # bias is worth re-taking at bring-up rather than trusting indefinitely.
  gyro_bias: [-57.3, 143.5, -19.9]
  # ⚠️ A SINGLE SCALE DOES NOT DESCRIBE THIS PART. Two stationary poses, both
  # still to within 4 counts:
  #   gravity on sensor z: raw [ 61.9, -102.0, 2397.2]  |a| 2400.2
  #   gravity on sensor x: raw [-1959.9, 304.0, -262.1] |a| 2000.6
  # 20% apart, when |a| is supposed to be pose-independent. Consistent with a
  # large per-axis zero-g offset (~+350 counts, 0.17 g, on sensor z) — well
  # outside the MPU6500's spec and typical of the dies on these modules.
  # It matters: Mahony normalises the accel vector, so a common scale error
  # cancels out entirely, but an offset TILTS measured gravity — ~10 deg of
  # standing attitude error, which the self-level module would fly into.
  # accel_per_g below is now only a fallback. Fill these in from
  #     python3 -m tools.bringup imu32 --accel-cal      (six poses)
  # accel_offset: [0.0, 0.0, 0.0]
  # accel_per_g_axis: [0.0, 0.0, 0.0]
  accel_per_g: 2061.3
  # UNVERIFIED — sensor frame to airframe FRD. Identity until the board's
  # mounting is known; needs level + tilts. Run: bringup imu32 --calibrate
  axis_map:
    - [0, +1.0]
    - [1, +1.0]
    - [2, +1.0]
  kp: 2.0
  ki: 0.05
  verified: false
  # ✅ MEASURED 2026-08-04 with the ellipsoid tumble fit (calib UI, step 1).
  # This settles the 2400-vs-2000 question completely, and the answer is the
  # one that mattered: the SCALES are essentially perfect (2048.0 / 2047.6 /
  # 2088.3 against a nominal 2048), so nothing was wrong with the sensitivity.
  # The whole fault was a zero-g OFFSET of +316.4 counts on sensor z = 0.154 g,
  # worth 8.8 deg of false tilt in the gravity DIRECTION — which is the only
  # thing Mahony can see, since it normalises the vector.
  # Verified independently right after applying: reported gravity went from
  # 1.156 g to 1.003 g in the same orientation.
  accel_offset: [-7.0, 19.4, 316.4]
  accel_per_g_axis: [2048.0, 2047.6, 2088.3]

# --- compiled command module ----------------------------------------------
# Delivered 2026-08-04, accepted after tools/verify_module_delivery.py.
# Attitude-only self-level: drives roll/pitch/yaw, never sends throttle.
# It DOES compute a throttle (1224 level, 1298 at 45 deg tilt) as thrust-vector
# compensation, exposed only in the returned dict. That is ABOVE the 1100 bench
# cap, so the returned dict must never be applied raw — throttle only ever
# reaches the FC through set_stick -> aetr_frame. Moot under mask 11 (pilot owns
# ch3) but it is the standing rule for any future config that grants the
# companion throttle authority.
module:
  so_path: companion/command_module.cpython-313-aarch64-linux-gnu.so
  sha256: f52b7f8f91c34c66a78cea12be1babdd2c426d8ca51238bb083ef274ddfad1cd
  verify_on_load: true
